# Copy to gcp.env. This file contains deployment-specific values and is ignored.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
GCP_ZONE=us-west1-b
GCP_VM_NAME=gorilla-protocol-stream
GCP_MACHINE_TYPE=g2-standard-8
GCP_ACCELERATOR_TYPE=nvidia-l4-vws
GCP_NETWORK=gorilla-protocol
GCP_SUBNET=gorilla-protocol-us-west1
GCP_SUBNET_RANGE=10.42.0.0/24
GCP_ADDRESS_NAME=gorilla-protocol-ip
GCP_BOOT_DISK_GB=150

# Set these only after the VM address has a public DNS A record.
STREAM_DOMAIN=play.example.com
TLS_EMAIL=admin@example.com
GAME_BINARY=/opt/gorilla-game/GorillaProtocol.sh
TURN_TTL=3600
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
