# Copy to gcp.env. This file contains deployment-specific values and is ignored.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
GCP_ZONE=us-west1-a
GCP_VM_NAME=gorilla-protocol-stream
GCP_MACHINE_TYPE=g2-standard-8
GCP_ACCELERATOR_TYPE=nvidia-l4-vws
GCP_NETWORK=gorilla-protocol
GCP_SUBNET=gorilla-protocol-us-west1
GCP_SUBNET_RANGE=10.42.0.0/24
GCP_ADDRESS_NAME=gorilla-protocol-ip
GCP_BOOT_DISK_GB=150

# Use "auto" for a free IP-based sslip.io hostname, or supply your own domain.
STREAM_DOMAIN=auto
GAME_BINARY=/opt/gorilla-game/GorillaProtocol.sh
TURN_TTL=3600
STREAM_WIDTH=1600
STREAM_HEIGHT=900
STREAM_FPS=60
STREAM_MIN_BITRATE=500000
STREAM_START_BITRATE=6000000
STREAM_MAX_BITRATE=8000000
IDLE_SHUTDOWN_SECONDS=600
BOOT_GRACE_SECONDS=900
MAX_RUNTIME_SECONDS=7200
GCP_MONTHLY_BUDGET_USD=30
