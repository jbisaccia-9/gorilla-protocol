[Unit]
Description=Gorilla Protocol Unreal Pixel Streaming process
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/gorilla-protocol/Hosting/.env
ConditionPathIsExecutable=/opt/gorilla-game/GorillaProtocol.sh

[Service]
Type=simple
User=gorilla-stream
Group=gorilla-stream
WorkingDirectory=/opt/gorilla-game
ExecStart=/opt/gorilla-protocol/Hosting/bin/start_streamer_linux.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/gorilla-game /var/lib/gorilla

[Install]
WantedBy=multi-user.target
