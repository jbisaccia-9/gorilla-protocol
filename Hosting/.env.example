# Public DNS name whose A/AAAA record points to the GPU host.
STREAM_DOMAIN=play.example.com

# Public IPv4 address used by CoTURN for WebRTC relay candidates.
PUBLIC_IP=203.0.113.10

# Optional address used by the automatic TLS certificate authority.
TLS_EMAIL=operator@example.com

# Epic infrastructure is downloaded here and pinned by commit.
PIXEL_STREAMING_INFRA_DIR=./.cache/PixelStreamingInfrastructure

# Packaged Linux executable on the GPU host.
GAME_BINARY=/opt/gorilla-protocol/package/GorillaProtocol.sh
STREAMER_URL=ws://127.0.0.1:8888
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
TURN_TTL=3600
